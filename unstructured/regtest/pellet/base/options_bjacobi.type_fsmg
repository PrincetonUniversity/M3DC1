-pc_type bjacobi
-pc_bjacobi_blocks 4
-sub_pc_type lu
-sub_pc_factor_mat_solver_type superlu_dist
-sub_ksp_type preonly
-ksp_type fgmres
-ksp_gmres_restart 220
-ksp_max_it 10000
-ksp_rtol 1.e-9
-ksp_atol 1.e-20
-ksp_converged_reason


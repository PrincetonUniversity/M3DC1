        -fs_fieldsplit_1_sub_ksp_type preonly
        -fs_fieldsplit_2_sub_pc_type lu
        -fs_fieldsplit_2_sub_pc_factor_mat_solver_type superlu_dist
        -fs_fieldsplit_2_sub_ksp_type preonly


        -mg_levels_fieldsplit_0_sub_pc_type lu
        -mg_levels_fieldsplit_0_sub_ksp_type preonly
        -mg_levels_fieldsplit_0_sub_pc_factor_mat_solver_type superlu_dist
        -mg_levels_fieldsplit_1_sub_pc_type lu
        -mg_levels_fieldsplit_1_sub_pc_factor_mat_solver_type superlu_dist
        -mg_levels_fieldsplit_1_sub_ksp_type preonly

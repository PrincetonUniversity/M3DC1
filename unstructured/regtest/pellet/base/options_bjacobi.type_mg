-pc_type bjacobi
-pc_bjacobi_blocks 4
-sub_pc_type lu
-sub_pc_factor_mat_solver_type superlu_dist
-sub_ksp_type preonly
-ksp_type fgmres
-ksp_gmres_restart 220
-ksp_max_it 10000
-ksp_rtol 1.e-9
-ksp_atol 1.e-20
-ksp_converged_reason

-on_error_abort
-ksp_error_if_not_converged 
-options_left

-xmg_nlevels 2 
-hard_ksp_type fgmres 
-hard_ksp_norm_type unpreconditioned 
-hard_pc_type mg 

-mg_levels_ksp_type fgmres 
-mg_levels_pc_type bjacobi 
-mg_levels_sub_pc_type lu 
-mg_levels_sub_pc_factor_mat_solver_type superlu_dist 
-mg_levels_sub_ksp_type preonly
#-mg_levels_ksp_max_it 3

-mg_coarse_ksp_type fgmres 
-mg_coarse_pc_type bjacobi 
-mg_coarse_sub_pc_type lu 
-mg_coarse_sub_pc_factor_mat_solver_type superlu_dist 
-mg_coarse_sub_ksp_type preonly
#-mg_coarse_ksp_max_it 3


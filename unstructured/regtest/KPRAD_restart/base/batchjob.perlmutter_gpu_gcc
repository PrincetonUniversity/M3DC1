#!/bin/bash
#SBATCH -A mp288_g
#SBATCH -q debug
#SBATCH -C gpu
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --gpus-per-node=4
#SBATCH -c 16
#SBATCH -J KPRAD_restart
#SBATCH -t 0:30:00
#SBATCH -o C1stdout

export MPICH_GPU_SUPPORT_ENABLED=1
export OMP_NUM_THREADS=1
export SLURM_CPU_BIND="cores"

echo $SLURM_CPUS_ON_NODE

CUDSS_LIB="${CUDSS_DIR:-/global/cfs/cdirs/mp288/jinchen/LIB/deps/cudss}/lib"
export LD_LIBRARY_PATH="$CUDSS_LIB:${NCCL_DIR}/lib:${LD_LIBRARY_PATH}"

DEVICE=$((SLURM_GPUS_PER_NODE * SLURM_JOB_NUM_NODES))
echo "Total GPUs: $DEVICE"

touch started

echo "=== m3dc1_cudss Config MG: $SLURM_NTASKS ranks / $SLURM_JOB_NUM_NODES node, $DEVICE per rank"

# partition mesh
PARTS=1
$M3DC1_MPIRUN -n $PARTS split_smb analytic-2K.smb part.smb $PARTS
echo $? > mesh_partitioned


# Run M3D-C1
cp C1input.1 C1input
$M3DC1_MPIRUN -n $PARTS -c $SLURM_CPUS_PER_TASK --cpu-bind=cores --gpu-bind=none --export=ALL \
	m3dc1_2d \
	-cudsssolve_mg 1 \
	-mg_devices ${DEVICE} \
	-log_view -log_view_gpu_time \
	-ksp_view \
	-options_left
#	-ksp_type preonly \

# Run M3D-C1
cp C1input.2 C1input
$M3DC1_MPIRUN -n $PARTS -c $SLURM_CPUS_PER_TASK --cpu-bind=cores --gpu-bind=none --export=ALL \
	m3dc1_2d \
	-cudsssolve_mg 1 \
	-mg_devices ${DEVICE} \
	-log_view -log_view_gpu_time \
	-ksp_view \
	-options_left
#	-ksp_type preonly \

cp -p C1ke "C1ke.${SLURM_JOB_ID}"

touch finished

#	-mat_type aijcusparse -vec_type cuda \

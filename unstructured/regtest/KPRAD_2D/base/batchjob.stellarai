#!/bin/bash
##SBATCH -A pppl
#SBATCH -N 1
#SBATCH --ntasks-per-node=48
#SBATCH --cpus-per-task=1
#SBATCH -J KPRAD2D
#SBATCH -t 00:30:00
#SBATCH -o C1stdout

touch started

#create_fixed_mesh.sh AnalyticModel 0.06
#echo $? > mesh_created

PARTS=48
$M3DC1_MPIRUN -n $PARTS split_smb analytic-2K.smb part.smb $PARTS
echo $? > mesh_partitioned

$M3DC1_MPIRUN -n 48 m3dc1_2d

touch finished

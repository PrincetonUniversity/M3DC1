#%Module1.0
##

## Required internal variables

set             name            m3dc1
set             version         devel
set             root            $env(M3DC1_CODE_DIR)

## List conflicting modules here

conflict $name

## List prerequisite modules here

set             fullname        M3D-C1
set             externalurl     http://w3.pppl.gov/~nferraro/m3dc1.html
set             description     "M3D-C1 is an extended-MHD code"

## Required for "module help ..."

proc ModulesHelp { } {
  global description externalurl
  puts stderr "Description - $description"
  puts stderr "Other Docs  - $externalurl"
}

## Required for "module display ..." and SWDB

module-whatis                   "$description"

## Software-specific settings exported to user environment

if { ! [ is-loaded PrgEnv-gnu/8.7.0 ] } {
  module load PrgEnv-gnu/8.7.0
}

if { ! [ is-loaded cray-mpich/9.1.0  ] } {
  module load cray-mpich/9.1.0 
}

if { ! [ is-loaded cudatoolkit/13.2 ] } {
  module load cudatoolkit/13.2
}

if { ! [ is-loaded nccl/2.29.2-cu13 ] } {
  module load nccl/2.29.2-cu13
}

if { ! [ is-loaded cray-hdf5-parallel/1.14.3.9 ] } {
  module load cray-hdf5-parallel/1.14.3.9
}
if { ! [ is-loaded cray-parallel-netcdf/1.12.3.13 ] } {
  module load cray-parallel-netcdf/1.12.3.13
}

if { ! [ is-loaded cray-fftw/3.3.10.11 ] } {
  module load cray-fftw/3.3.10.11
}

#if { ! [ is-loaded gsl/2.5 ] } {
#  module load gsl/2.5
#}

#if { ! [ is-loaded idl ] } {
#  module load idl
#}

#if { ! [ is-loaded fast-mkl-amd ] } {
#  module load fast-mkl-amd
#}

setenv          M3DC1_VERSION   $version
setenv          M3DC1_DIR       $root
setenv		M3DC1_ARCH	perlmutter_gpu_gcc
setenv		M3DC1_MPIRUN	srun

prepend-path    PATH             $root/unstructured/_perlmutter_gpu_gcc/bin
prepend-path    IDL_PATH         $root/unstructured/idl
